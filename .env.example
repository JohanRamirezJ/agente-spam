# Copia este archivo a .env y ajusta. NUNCA subas .env al repositorio.

# --- Seguridad (obligatorio si lo expones a internet) ---
# Clave de administrador: reentrenar, borrar/importar confirmaciones y volver a la versión anterior.
# Genera una larga:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RETRAIN_TOKEN=cambia-esto-por-una-clave-larga
# true = solo quien tenga la clave puede confirmar casos (enseñar al modelo). Recomendado en público.
FEEDBACK_REQUIRES_TOKEN=true
# true solo si hay un proxy inverso TUYO delante (Caddy, Render, Fly...). Hace que el límite use la IP real.
TRUST_PROXY=true
# Solicitudes por minuto y por IP (0 = sin límite).
RATE_LIMIT_PER_MIN=120

# --- Modelo ---
SPAM_THRESHOLD=0.5
SPAM_SURE_THRESHOLD=0.8

# --- Almacenamiento (modelo en uso + confirmaciones + historial) ---
DATA_DIR=/data

# --- Solo para docker-compose con HTTPS automático (Caddy) ---
DOMAIN=agente.tudominio.com
